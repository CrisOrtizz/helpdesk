# Copiar a .env y ajustar valores para desarrollo local
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@db:5432/helpdesk_db

# Cambiar en producción — debe ser un string largo y aleatorio
SECRET_KEY=change-me-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email con Resend (https://resend.com)
# Dejar vacío para que los links de reset se impriman en los logs (modo dev)
RESEND_API_KEY=

# URL del frontend — se usa para armar los links de reset y para CORS
FRONTEND_URL=http://localhost:5173
